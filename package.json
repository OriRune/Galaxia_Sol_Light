{
  "name": "galaxia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "preview": "vite preview --host 127.0.0.1",
    "preview:benchmark": "vite preview --host 127.0.0.1 --port 4174",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck": "run-s typecheck:app typecheck:worker typecheck:node",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "run-s test:coverage:unit test:coverage:browser test:coverage:merge",
    "test:coverage:unit": "vitest run --project unit --coverage.enabled --coverage.provider=istanbul --coverage.reportsDirectory=coverage/unit",
    "test:coverage:browser": "vitest run --project browser --browser.name=chromium --coverage.enabled --coverage.provider=istanbul --coverage.reportsDirectory=coverage/browser",
    "test:coverage:merge": "node scripts/merge-coverage.mjs",
    "coverage:check": "node scripts/check-coverage.mjs coverage/coverage-final.json",
    "verify:paths": "node scripts/verify-no-absolute-paths.mjs",
    "verify:production-hooks": "node scripts/verify-production-hooks.mjs",
    "verify:dist-hosting": "node scripts/verify-dist-hosting.mjs",
    "record:environment": "node scripts/record-environment.mjs",
    "build:vite": "vite build",
    "build": "run-s typecheck build:vite",
    "architecture:check": "depcruise --config dependency-cruiser.cjs src",
    "e2e": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:edge": "playwright test --project=edge",
    "e2e:hosted": "playwright test --project=hosted-chromium --project=hosted-firefox",
    "e2e:hosted:local": "playwright test --config=perf/playwright.hosted-local.config.ts",
    "bench": "playwright test --config=perf/playwright.perf.config.ts",
    "bench:renderer:edge": "playwright test --config=perf/playwright.normative.config.ts",
    "bench:renderer:firefox": "node perf/run-system-firefox.mjs",
    "soak:recording": "playwright test --config=perf/playwright.soak.config.ts",
    "verify": "run-s format:check typecheck lint architecture:check verify:paths test:coverage coverage:check build verify:production-hooks e2e:chromium e2e:firefox",
    "vercel:build": "vercel build",
    "deploy:preview": "vercel",
    "deploy:production": "vercel --prod"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "fflate": "0.8.3",
    "pixi.js": "8.19.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vercel": "56.2.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
